# Copy to .env locally. Never commit .env (see .gitignore).
ENERGY_DATA_DIR=data
ENERGY_ARTIFACT_DIR=artifacts
ENERGY_MODEL_PATH=artifacts/model.joblib
# Local MLflow; do not expose the UI without access control.
ENERGY_MLFLOW_URI=sqlite:///mlflow.db
AWS_REGION=us-east-1
ENERGY_S3_BUCKET=replace-with-your-bucket
